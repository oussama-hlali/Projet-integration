{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/angular-front/browser",
  "installCommand": "npm ci",
  "framework": "angular",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "env": {
    "NG_APP_API_BASE_URL": "https://smart-campus-gateway.onrender.com/api/v1"
  },
  "preview": {
    "env": {
      "NG_APP_API_BASE_URL": "https://smart-campus-gateway-staging.onrender.com/api/v1"
    }
  }
}
